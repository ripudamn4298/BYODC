// BYODC on Cloudflare Workers (static assets + a small /api Worker). See HOSTING.md.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "byodc",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "byodc", "database_id": "990629ed-191e-4e8e-a350-84dade0406c0" }
  ]
  // GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set as secrets in the dashboard, not here.
}
